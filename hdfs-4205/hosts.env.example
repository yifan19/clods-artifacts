# Copy this file to hosts.env and fill in your 4 real EC2 instances (plain Ubuntu — 20.04 or 24.04,
# both confirmed to work, see run_experiment_aws.sh's "OS note") before running ./run_experiment_aws.sh.
#
# All 4 instances must be able to reach each other on port 22 (and the HDFS/HBase/ZooKeeper ports
# this bug uses — simplest is one security group with all traffic allowed between its own members).
# SSH_USER must have passwordless sudo (true of the default "ubuntu" user on stock Ubuntu AMIs).

MASTER_HOST=1.2.3.4
SLAVE_HOSTS="1.2.3.5 1.2.3.6 1.2.3.7"

# Path to the private key that logs into all 4 instances (same keypair on all 4 is simplest: the
# script copies it onto MASTER_HOST so master can also SSH into each slave directly, exactly like
# the original historical cluster scripts did).
SSH_KEY=~/.ssh/my-ec2-key.pem
SSH_USER=ubuntu

# Optional: this bug's README/manifest.py flags that the symptom class lives in NameNode
# (INodeDirectory) even though the original script's own APP_NAME argument says "DataNode" — if the
# default (DataNode/slaves) doesn't reproduce, uncomment these to try the other target instead of
# editing run_experiment_aws.sh.
#APP_NAME_OVERRIDE=Namenode
#APP_TARGET_OVERRIDE=master
